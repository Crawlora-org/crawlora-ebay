    "api-client",
    "sdk",
    "web-scraping",
    "scraping-api",
    "ebay",
    "ebay-api",
    "ebay-scraper",
    "ebay-data",
    "ebay-listing-search",
    "ebay-item-details",
    "ebay-seller-profiles",
    "ebay-feedback-shops",
    "ebay-live-streams"
  ],
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "autoload": {
