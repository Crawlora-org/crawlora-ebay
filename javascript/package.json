{
  "name": "@crawlora-org/ebay",
  "version": "0.1.2",
  "description": "Crawlora eBay API client with 10 endpoints for listing search, item details, seller profiles, feedback and shops, and eBay Live streams",
  "homepage": "https://crawlora.net/?utm_source=npm&utm_medium=referral&utm_campaign=platform-clients&utm_content=ebay-javascript-homepage",
  "bugs": { "url": "https://github.com/Crawlora-org/crawlora-ebay/issues" },
  "keywords": ["crawlora", "api-client", "sdk", "web-scraping", "scraping-api", "ebay", "ebay-api", "ebay-scraper", "ebay-data", "ebay-listing-search", "ebay-item-details", "ebay-seller-profiles", "ebay-feedback-shops", "ebay-live-streams"],
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "files": ["src", "README.md", "LICENSE"],
  "engines": { "node": ">=18" },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Crawlora-org/crawlora-ebay",
    "directory": "javascript"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "typecheck": "tsc --noEmit",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "generate": "python3 ../scripts/generate.py"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  }
}
